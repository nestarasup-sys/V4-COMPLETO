{
  "name": "gacha-v4-completo",
  "version": "0.1.0",
  "private": true,
  "description": "Criador chibi Corpo/Pose com Electron",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "check": "node --check src/core.js && node --check src/renderer.js && node --check src/drag.js && node --check electron/main.cjs && node --check electron/preload.cjs",
    "dist": "electron-builder",
    "ui-test": "electron --no-sandbox test/ui-smoke.cjs",
    "test:e2e": "electron --no-sandbox test/electron.e2e.cjs"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.gachav4.bodyeditor",
    "productName": "Gacha V4 Corpo e Pose",
    "files": [
      "index.html",
      "styles.css",
      "src/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Graphics"
    },
    "mac": {
      "target": "dmg"
    }
  },
  "author": "nestarasup-sys"
}
